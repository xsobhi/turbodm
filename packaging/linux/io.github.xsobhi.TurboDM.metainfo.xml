<component type="desktop-application">
  <id>io.github.xsobhi.TurboDM</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>TurboDM</name>
  <summary>Fast multi-connection download manager</summary>
  <description>
    <p>
      TurboDM downloads files over up to 32 connections at once, in the spirit of Internet
      Download Manager. Pause and resume survive restarts, and the browser extension hands
      downloads over from Firefox, Chrome, Brave and Chromium with their cookies.
    </p>
  </description>
  <launchable type="desktop-id">turbodm.desktop</launchable>
  <url type="homepage">https://github.com/xsobhi/turbodm</url>
  <developer id="io.github.xsobhi">
    <name>xsobhi</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/xsobhi/turbodm/main/docs/main-window.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>turbodm</binary>
  </provides>
</component>
